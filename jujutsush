local vesselDebounce = false
local honoredDebounce = false

local function handleMacroTrigger(inputObj)
	if state.MacroVesselBind and (inputObj.KeyCode == state.MacroVesselBind or inputObj.UserInputType == state.MacroVesselBind) then
		if vesselDebounce then return end
		vesselDebounce = true
		
		task.spawn(function()
			local closestDist = 12
			local closestPlr = nil
			local char = player.Character
			
			if char and char:FindFirstChild("HumanoidRootPart") then
				local hrp = char.HumanoidRootPart
				for _, p in pairs(Players:GetPlayers()) do
					if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
						local dist = (p.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
						if dist < closestDist then
							closestDist = dist
							closestPlr = p
						end
					end
				end
				
				if closestPlr then
					local targetHRP = closestPlr.Character.HumanoidRootPart
					local backPos = targetHRP.Position - (targetHRP.CFrame.LookVector * 2.5)
					hrp.CFrame = CFrame.new(backPos, targetHRP.Position)
					task.wait(0.05)
				end
			end

			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
			
			task.wait(state.DelayVessel3)
			
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
			
			task.wait(0.1)
			vesselDebounce = false
		end)
	end

	if state.MacroHonoredBind and (inputObj.KeyCode == state.MacroHonoredBind or inputObj.UserInputType == state.MacroHonoredBind) then
		if honoredDebounce then return end
		honoredDebounce = true
		
		task.spawn(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
			
			task.wait(state.DelayHonoredRapid)
			
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
			task.wait(0.05)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
			
			task.wait(0.1)
			honoredDebounce = false
		end)
	end
end

