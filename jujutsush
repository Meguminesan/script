local function updateESP(obj, textStr)
	if not obj then return end
	if state.ESPInstances[obj] then
		state.ESPInstances[obj].Highlight:Destroy()
		if state.ESPInstances[obj].Billboard then state.ESPInstances[obj].Billboard:Destroy() end
		state.ESPInstances[obj] = nil
	end
	local hl = Instance.new("Highlight")
	hl.Adornee = obj
	hl.FillColor = theme.Accent
	hl.FillTransparency = state.Chams and 0.2 or 0.7
	hl.OutlineColor = Color3.new(1,1,1)
	hl.Parent = CoreGui
	local bb = Instance.new("BillboardGui")
	bb.Adornee = obj:IsA("Model") and obj:FindFirstChild("Head") or obj
	bb.Size = UDim2.new(0, 200, 0, 50)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = CoreGui
	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.new(1,0,1,0)
	txt.BackgroundTransparency = 1
	txt.Text = textStr
	txt.TextColor3 = theme.Accent
	txt.TextStrokeTransparency = 0
	txt.Font = Enum.Font.GothamBold
	txt.TextSize = 14
	txt.Parent = bb
	state.ESPInstances[obj] = {Highlight = hl, Billboard = bb}
end

