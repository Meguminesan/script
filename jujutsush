local function createESPObj(plr)
	local d = {
		Box = Instance.new("Frame"),
		BoxOutline = Instance.new("UIStroke"),
		Name = Instance.new("TextLabel"),
		Dist = Instance.new("TextLabel"),
		HealthBg = Instance.new("Frame"),
		HealthFill = Instance.new("Frame"),
		Tracer = Instance.new("Frame"),
		Highlight = Instance.new("Highlight")
	}
	
	d.Box.BackgroundTransparency = 1
	d.Box.Visible = false
	d.Box.Parent = espFolder
	d.BoxOutline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	d.BoxOutline.Parent = d.Box
	
	d.Name.BackgroundTransparency = 1
	d.Name.Font = Enum.Font.GothamBold
	d.Name.TextSize = 13
	d.Name.TextStrokeTransparency = 0
	d.Name.Visible = false
	d.Name.Parent = espFolder
	
	d.Dist.BackgroundTransparency = 1
	d.Dist.Font = Enum.Font.Gotham
	d.Dist.TextSize = 11
	d.Dist.TextStrokeTransparency = 0
	d.Dist.Visible = false
	d.Dist.Parent = espFolder
	
	d.HealthBg.BackgroundColor3 = Color3.new(0,0,0)
	d.HealthBg.BorderSizePixel = 0
	d.HealthBg.Visible = false
	d.HealthBg.Parent = espFolder
	d.HealthFill.BackgroundColor3 = Color3.new(0,1,0)
	d.HealthFill.BorderSizePixel = 0
	d.HealthFill.Parent = d.HealthBg
	
	d.Tracer.BackgroundColor3 = Color3.new(1,1,1)
	d.Tracer.BorderSizePixel = 0
	d.Tracer.AnchorPoint = Vector2.new(0.5, 0.5)
	d.Tracer.Visible = false
	d.Tracer.Parent = espFolder
	
	d.Highlight.Parent = CoreGui
	d.Highlight.Enabled = false
	
	state.ESPInstances[plr] = d
end

local function removeESPObj(plr)
	if state.ESPInstances[plr] then
		for _, v in pairs(state.ESPInstances[plr]) do
			pcall(function() v:Destroy() end)
		end
		state.ESPInstances[plr] = nil
	end
end

for _, p in pairs(Players:GetPlayers()) do
	if p ~= player then createESPObj(p) end
end

table.insert(state.Connections, Players.PlayerAdded:Connect(function(p)
	createESPObj(p)
end))

table.insert(state.Connections, Players.PlayerRemoving:Connect(function(p)
	removeESPObj(p)
end))

table.insert(state.Connections, RunService.RenderStepped:Connect(function()
	if state.WorldFullbright then Lighting.Ambient = Color3.fromRGB(255, 255, 255) end
	camera.FieldOfView = state.WorldFOV

	for plr, d in pairs(state.ESPInstances) do
		local char = plr.Character
		if state.ESPEnabled and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
			local hrp = char.HumanoidRootPart
			local head = char:FindFirstChild("Head") or hrp
			local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
			
			if onScreen then
				local headPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
				local legPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
				local h = legPos.Y - headPos.Y
				local w = h / 2

				if state.ESPBoxes then
					d.Box.Size = UDim2.new(0, w, 0, h)
					d.Box.Position = UDim2.new(0, headPos.X - w/2, 0, headPos.Y)
					d.BoxOutline.Color = state.ESPBoxColor
					d.Box.Visible = true
				else d.Box.Visible = false end

				if state.ESPNames then
					d.Name.Text = plr.Name
					d.Name.Position = UDim2.new(0, headPos.X, 0, headPos.Y - 20)
					d.Name.TextColor3 = state.ESPNameColor
					d.Name.Visible = true
				else d.Name.Visible = false end

				if state.ESPDistance then
					local dist = math.floor((camera.CFrame.Position - hrp.Position).Magnitude)
					d.Dist.Text = tostring(dist) .. "m"
					d.Dist.Position = UDim2.new(0, headPos.X, 0, legPos.Y + 5)
					d.Dist.TextColor3 = state.ESPDistColor
					d.Dist.Visible = true
				else d.Dist.Visible = false end

				if state.ESPHealth then
					local hp = char.Humanoid.Health / char.Humanoid.MaxHealth
					d.HealthBg.Size = UDim2.new(0, 4, 0, h)
					d.HealthBg.Position = UDim2.new(0, headPos.X - w/2 - 6, 0, headPos.Y)
					d.HealthFill.Size = UDim2.new(1, 0, hp, 0)
					d.HealthFill.Position = UDim2.new(0, 0, 1 - hp, 0)
					d.HealthFill.BackgroundColor3 = Color3.fromHSV(hp * 0.3, 1, 1)
					d.HealthBg.Visible = true
				else d.HealthBg.Visible = false end

				if state.ESPTracers then
					local oX, oY = camera.ViewportSize.X/2, camera.ViewportSize.Y
					if state.ESPTracerOrigin == "Center" then oY = camera.ViewportSize.Y/2 end
					local startV = Vector2.new(oX, oY)
					local endV = Vector2.new(legPos.X, legPos.Y)
					local distance = (startV - endV).Magnitude
					d.Tracer.Size = UDim2.new(0, 1, 0, distance)
					d.Tracer.Position = UDim2.new(0, (startV.X + endV.X)/2, 0, (startV.Y + endV.Y)/2)
					d.Tracer.Rotation = math.deg(math.atan2(endV.Y - startV.Y, endV.X - startV.X)) + 90
					d.Tracer.BackgroundColor3 = state.ESPTracerColor
					d.Tracer.Visible = true
				else d.Tracer.Visible = false end
			else
				d.Box.Visible = false
				d.Name.Visible = false
				d.Dist.Visible = false
				d.HealthBg.Visible = false
				d.Tracer.Visible = false
			end

			if state.ESPChams then
				d.Highlight.Adornee = char
				d.Highlight.FillColor = state.ESPChamsFill
				d.Highlight.OutlineColor = state.ESPChamsOutline
				d.Highlight.FillTransparency = state.ESPChamsTrans
				d.Highlight.Enabled = true
			else d.Highlight.Enabled = false end

		else
			d.Box.Visible = false
			d.Name.Visible = false
			d.Dist.Visible = false
			d.HealthBg.Visible = false
			d.Tracer.Visible = false
			d.Highlight.Enabled = false
		end
	end
end))
