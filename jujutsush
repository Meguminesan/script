					bindBtn.Text = "[" .. name .. "]"
					if callback then callback(input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType) end
				end
				connection:Disconnect()
				connection = nil
			end
		end)
	end)
