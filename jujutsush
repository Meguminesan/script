local function createColorPicker(parent, text, defaultColor, callback)
	local cContainer = Instance.new("Frame")
	cContainer.Size = UDim2.new(1, 0, 0, 140)
	cContainer.BackgroundColor3 = theme.Sidebar
	cContainer.ClipsDescendants = true
	cContainer.Parent = parent
	applyCorner(cContainer, 8)
	applyStroke(cContainer, theme.Stroke, 1)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -50, 0, 30)
	lbl.Position = UDim2.new(0, 15, 0, 5)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = theme.TextPrimary
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 14
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = cContainer

	local colorPreview = Instance.new("Frame")
	colorPreview.Size = UDim2.new(0, 24, 0, 24)
	colorPreview.Position = UDim2.new(1, -39, 0, 8)
	colorPreview.BackgroundColor3 = defaultColor
	colorPreview.Parent = cContainer
	applyCorner(colorPreview, 6)
	applyStroke(colorPreview, theme.Stroke, 1)

	local rVal, gVal, bVal = defaultColor.R * 255, defaultColor.G * 255, defaultColor.B * 255

	local function updateColor()
		local nc = Color3.fromRGB(rVal, gVal, bVal)
		colorPreview.BackgroundColor3 = nc
		if callback then callback(nc) end
	end

	local function rgbSlider(yPos, cName, cColor, startVal, cb)
		local bg = Instance.new("TextButton")
		bg.Size = UDim2.new(1, -30, 0, 12)
		bg.Position = UDim2.new(0, 15, 0, yPos)
		bg.BackgroundColor3 = theme.ItemBG
		bg.Text = ""
		bg.AutoButtonColor = false
		bg.Parent = cContainer
		applyCorner(bg, 4)

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new(startVal / 255, 0, 1, 0)
		fill.BackgroundColor3 = cColor
		fill.BorderSizePixel = 0
		fill.Parent = bg
		applyCorner(fill, 4)

		local drag = false
		local function move(input)
			local pos = math.clamp(input.Position.X - bg.AbsolutePosition.X, 0, bg.AbsoluteSize.X)
			local pct = pos / bg.AbsoluteSize.X
			fill.Size = UDim2.new(pct, 0, 1, 0)
			cb(math.floor(pct * 255))
		end
		bg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true move(i) end end)
		UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
		UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType == Enum.UserInputType.MouseMovement then move(i) end end)
	end

	rgbSlider(40, "R", Color3.fromRGB(255, 50, 50), rVal, function(v) rVal = v updateColor() end)
	rgbSlider(70, "G", Color3.fromRGB(50, 255, 50), gVal, function(v) gVal = v updateColor() end)
	rgbSlider(100, "B", Color3.fromRGB(50, 150, 255), bVal, function(v) bVal = v updateColor() end)
end

