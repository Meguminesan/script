local secScanner = createSection(pageScanner, "Game Scanner")
local scannerResults = createSection(pageScanner, "Results")

local function performScan()
	for _, child in ipairs(scannerResults:GetChildren()) do
		if child:IsA("Frame") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
			child:Destroy()
		end
	end

	local foundItems = {}

	local function checkInstance(inst)
		local nameLower = string.lower(inst.Name)
		if string.find(nameLower, "product") or string.find(nameLower, "gamepass") or string.find(nameLower, "pass") or string.find(nameLower, "id") then
			if inst:IsA("IntValue") or inst:IsA("NumberValue") or inst:IsA("StringValue") then
				local val = tonumber(inst.Value)
				if val and val > 1000 then
					foundItems[inst.Name] = val
				end
			end
		end
		
		for attr, val in pairs(inst:GetAttributes()) do
			local attrLower = string.lower(attr)
			if string.find(attrLower, "product") or string.find(attrLower, "gamepass") or string.find(attrLower, "id") then
				if type(val) == "number" and val > 1000 then
					foundItems[inst.Name .. " [" .. attr .. "]"] = val
				end
			end
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		checkInstance(v)
	end

	for _, v in ipairs(playerGui:GetDescendants()) do
		checkInstance(v)
	end

	local count = 0
	for name, id in pairs(foundItems) do
		createLogCard(scannerResults, name, id)
		count = count + 1
	end

	if count == 0 then
		createLabel(scannerResults, "No IDs found in workspace/gui.", theme.Warning)
		sendNotification("Scan Complete", "No IDs were found.", theme.Danger)
	else
		sendNotification("Scan Complete", "Found " .. count .. " potential IDs.", theme.Success)
	end
end

createButton(secScanner, "Start Scan (Workspace & GUI)", theme.Accent, performScan)
