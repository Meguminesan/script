local function hexToColor3(hex)
	hex = hex:gsub("#","")
	if #hex == 6 then
		return Color3.fromRGB(tonumber("0x"..hex:sub(1,2)), tonumber("0x"..hex:sub(3,4)), tonumber("0x"..hex:sub(5,6)))
	end
	return Color3.new(1,1,1)
end

local function applyESPToObj(obj, color, useChams, nameText, nameColor)
	local hl = obj:FindFirstChild("NK_Highlight")
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "NK_Highlight"
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = obj
	end
	hl.FillColor = color
	hl.OutlineColor = Color3.new(1,1,1)
	hl.FillTransparency = useChams and 0.4 or 1
	hl.OutlineTransparency = 0
	
	if nameText then
		local head = obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
		if head then
			local bb = head:FindFirstChild("NK_NameTag")
			if not bb then
				bb = Instance.new("BillboardGui")
				bb.Name = "NK_NameTag"
				bb.Size = UDim2.new(0, 200, 0, 50)
				bb.StudsOffset = Vector3.new(0, 2, 0)
				bb.AlwaysOnTop = true
				
				local tl = Instance.new("TextLabel")
				tl.Size = UDim2.new(1, 0, 1, 0)
				tl.BackgroundTransparency = 1
				tl.Font = Enum.Font.GothamBold
				tl.TextSize = 14
				tl.TextStrokeTransparency = 0
				tl.Parent = bb
				
				bb.Parent = head
			end
			bb.TextLabel.Text = nameText
			bb.TextLabel.TextColor3 = nameColor
		end
	end
end

local function removeESP(obj)
	local hl = obj:FindFirstChild("NK_Highlight")
	if hl then hl:Destroy() end
	for _, v in ipairs(obj:GetDescendants()) do
		if v.Name == "NK_NameTag" then v:Destroy() end
	end
end

task.spawn(function()
	while task.wait(1.5) do
		if isKeyValid then
			local chamsColor = hexToColor3(SETTINGS.ESP_CHAMS_COLOR)
			local nameColor = hexToColor3(SETTINGS.ESP_NAME_COLOR)
			
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player and p.Character then
					if SETTINGS.ESP_PLAYERS then
						applyESPToObj(p.Character, chamsColor, SETTINGS.ESP_CHAMS, p.Name, nameColor)
					else
						removeESP(p.Character)
					end
				end
			end
			
			local descendants = workspace:GetDescendants()
			if SETTINGS.ESP_MONSTERS or SETTINGS.ESP_ITEMS or SETTINGS.ESP_PHILLIPS or SETTINGS.ESP_FUSE or SETTINGS.ESP_BATTERY or SETTINGS.ESP_FLASHLIGHT or SETTINGS.ESP_MEGAPHONE then
				for i, obj in ipairs(descendants) do
					if obj:IsA("Model") or obj:IsA("BasePart") then
						local isMonster = obj.Name == "Bonnie" or obj.Name == "Freddy" or obj.Name == "Foxy" or obj.Name == "Chica" or obj.Name == "Puppet" or obj.Name == "Cake"
						local isItem = SETTINGS.ITEM_SEARCH ~= "" and string.lower(obj.Name) == string.lower(SETTINGS.ITEM_SEARCH)
						
						local isPhillips = SETTINGS.ESP_PHILLIPS and obj.Name == "Phillips screwdriver"
						local isFuse = SETTINGS.ESP_FUSE and obj.Name == "Fuse"
						local isBattery = SETTINGS.ESP_BATTERY and obj.Name == "Battery"
						local isFlashlight = SETTINGS.ESP_FLASHLIGHT and obj.Name == "Old Flashlight"
						local isMegaphone = SETTINGS.ESP_MEGAPHONE and obj.Name == "Megaphone"
						
						if SETTINGS.ESP_MONSTERS and isMonster then
							applyESPToObj(obj, Color3.new(1,0,0), true, obj.Name, Color3.new(1,0,0))
						elseif SETTINGS.ESP_ITEMS and isItem then
							applyESPToObj(obj, Color3.new(0,1,0), true, obj.Name, Color3.new(0,1,0))
						elseif isPhillips or isFuse or isBattery or isFlashlight or isMegaphone then
							applyESPToObj(obj, Color3.new(0,0.5,1), true, obj.Name, Color3.new(0,0.5,1))
						else
							if obj:FindFirstChild("NK_Highlight") and not Players:GetPlayerFromCharacter(obj) then
								removeESP(obj)
							end
						end
					end
					if i % 1000 == 0 then task.wait() end
				end
			else
				for i, obj in ipairs(descendants) do
					if obj:FindFirstChild("NK_Highlight") and not Players:GetPlayerFromCharacter(obj) then
						removeESP(obj)
					end
					if i % 1000 == 0 then task.wait() end
				end
			end
		end
	end
end)


