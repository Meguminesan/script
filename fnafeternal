local function createSlider(parent, text, min, max, settingKey)
	local sliderContainer = Instance.new("Frame")
	sliderContainer.Size = UDim2.new(1, 0, 0, 50)
	sliderContainer.BackgroundColor3 = theme.Sidebar
	sliderContainer.Parent = parent
	applyCorner(sliderContainer, 8)
	applyStroke(sliderContainer, theme.Stroke, 1)

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(0.6, 0, 0, 20)
	titleLbl.Position = UDim2.new(0, 10, 0, 5)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = text
	titleLbl.TextColor3 = theme.TextPrimary
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 13
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = sliderContainer

	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(0.3, 0, 0, 20)
	valLbl.Position = UDim2.new(0.7, -10, 0, 5)
	valLbl.BackgroundTransparency = 1
	valLbl.Text = tostring(SETTINGS[settingKey])
	valLbl.TextColor3 = theme.Gold
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 13
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.Parent = sliderContainer

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -20, 0, 6)
	track.Position = UDim2.new(0, 10, 0, 32)
	track.BackgroundColor3 = theme.ItemBG
	track.BorderSizePixel = 0
	track.Parent = sliderContainer
	applyCorner(track, 3)

	local fill = Instance.new("Frame")
	local fillScale = (SETTINGS[settingKey] - min) / (max - min)
	fill.Size = UDim2.new(math.clamp(fillScale, 0, 1), 0, 1, 0)
	fill.BackgroundColor3 = theme.Accent
	fill.BorderSizePixel = 0
	fill.Parent = track
	applyCorner(fill, 3)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.Position = UDim2.new(math.clamp(fillScale, 0, 1), -7, 0.5, -7)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.Parent = track
	applyCorner(knob, 7)

	local sliding = false
	local function updateSlider(inputPos)
		local rel = math.clamp((inputPos - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local val = math.floor(min + rel * (max - min))
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, -7, 0.5, -7)
		valLbl.Text = tostring(val)
		SETTINGS[settingKey] = val
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			sliding = true
			updateSlider(input.Position.X)
		end
	end)
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(input.Position.X) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
	end)
end

