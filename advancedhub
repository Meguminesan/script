createButton(secUtil, "Teleport to Player", theme.Accent, function()
	if not targetPlayerInput or targetPlayerInput == "" then return end
	local targetStr = targetPlayerInput:lower()
	local foundTarget = nil
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #targetStr) == targetStr or p.DisplayName:lower():sub(1, #targetStr) == targetStr then
			foundTarget = p
			break
		end
	end
	if foundTarget and foundTarget.Character and foundTarget.Character:FindFirstChild("HumanoidRootPart") then
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			char.HumanoidRootPart.CFrame = foundTarget.Character.HumanoidRootPart.CFrame * CFrame.new(0,0,3)
			sendNotification("Teleported", "Teleported to " .. foundTarget.Name, theme.Success)
		end
