table.insert(state.Connections, RunService.RenderStepped:Connect(function()
	if state.Tracers then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
				local vector, onScreen = camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
				if onScreen then
					local line = state.TracerLines[p]
					if not line then
						line = Instance.new("Frame")
						line.BackgroundColor3 = theme.Accent
						line.BorderSizePixel = 0
						line.AnchorPoint = Vector2.new(0.5, 0.5)
						line.Parent = tracerFrame
						state.TracerLines[p] = line
					end
					local startVector = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
					local endVector = Vector2.new(vector.X, vector.Y)
					local distance = (startVector - endVector).Magnitude
					line.Size = UDim2.new(0, 2, 0, distance)
					line.Position = UDim2.new(0, (startVector.X + endVector.X) / 2, 0, (startVector.Y + endVector.Y) / 2)
					line.Rotation = math.deg(math.atan2(endVector.Y - startVector.Y, endVector.X - startVector.X)) + 90
				elseif state.TracerLines[p] then
					state.TracerLines[p]:Destroy()
					state.TracerLines[p] = nil
				end
			elseif state.TracerLines[p] then
				state.TracerLines[p]:Destroy()
				state.TracerLines[p] = nil
			end
		end
	end
end))

