	l.Text = "[" .. os.date("%H:%M:%S") .. "] " .. msg
	l.TextColor3 = color or theme.TextPrimary
	l.Font = Enum.Font.Code
	l.TextSize = 12
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = logContainer

	local children = logContainer:GetChildren()
	local maxLogs = 100
	local cList = {}
	for _, c in ipairs(children) do
		if c:IsA("TextLabel") then table.insert(cList, c) end
	end
	if #cList > maxLogs then cList[1]:Destroy() end
end

local function parseData(res)
	if type(res) == "number" then return tostring(res) end
	if type(res) == "string" then return res end
	if type(res) == "table" then
		local str = ""
		for k, v in pairs(res) do str = str .. tostring(k) .. ":" .. tostring(v) .. " " end
		return str ~= "" and str or "Success"
	end
	return "Success"
end

local function sendWebhook(title, rewardStr)
	if not SETTINGS.WEBHOOK_URL or SETTINGS.WEBHOOK_URL == "" then return end
	local data = {
		embeds = {{
			title = "🎉 " .. title,
			description = "**Reward Given:** " .. rewardStr .. "\n\n**Player:** " .. player.DisplayName,
			color = 9055202,
			timestamp = DateTime.now():ToIsoDate()
		}},
		username = "NK - Neko Webhooks"
	}
	local _req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
	if _req then
		task.spawn(function()
			pcall(function()
				_req({Url = SETTINGS.WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)})
			end)
		end)
	end
end

