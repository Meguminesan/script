local CONFIG_FILE = "NK_Neko_Settings_" .. tostring(player.UserId) .. ".json"
local function saveConfig()
	if writefile then pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(SETTINGS)) end) end
end
local function loadConfig()
	if readfile and isfile and isfile(CONFIG_FILE) then
		pcall(function()
			local decoded = HttpService:JSONDecode(readfile(CONFIG_FILE))
			if decoded then for k, v in pairs(decoded) do if SETTINGS[k] ~= nil then SETTINGS[k] = v end end end
		end)
	end
end
