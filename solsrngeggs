	toggleInv()
end

local function mainLoop()
	fixMapGeometry()
	guiLog("Farming started!", theme.Success)
	while STATE.running do
		if getgenv().NK_Farm_Unloaded or getgenv().NK_Farm_InstanceId ~= scriptId then STATE.running = false break end
		if SETTINGS.AUTO_EQUIP_ABYSSAL and rootPart and not rootPart:FindFirstChild("FishSpin") then
			autoEquipAbyssal() task.wait(0.5)
		end
		local eggs = findAllEggs()
		updateGUI()
		if #eggs == 0 then
			STATE.currentTarget = "Scanning..."
			STATE.status = "Searching"
			updateGUI()
			task.wait(SETTINGS.SEARCH_INTERVAL)
		else
			STATE.status = "Farming"
			for _, egg in ipairs(eggs) do
				if not STATE.running then break end
				if egg.part and egg.part.Parent then moveToEgg(egg) task.wait(0.3) end
			end
			task.wait(SETTINGS.SEARCH_INTERVAL)
		end
	end
	STATE.currentTarget = "—"
	STATE.status = "Stopped"
	updateGUI()
	guiLog("Farming stopped", theme.Danger)
end

startBtnObj = createButton(secControls, "▶ Start Farming", theme.Success, function()
	if STATE.running then return end
	STATE.running = true
	STATE.status = "Starting..."
	updateGUI()
	task.spawn(mainLoop)
	sendNotification("Started", "Auto-Farm has been initiated.", theme.Success)
end)

stopBtnObj = createButton(secControls, "■ Stop Farming", theme.Danger, function()
	if not STATE.running then return end
	STATE.running = false
	updateGUI()
	sendNotification("Stopped", "Auto-Farm has been halted.", theme.Danger)
end)

guiLog("System initialized. Awaiting start...", theme.Accent)
updateGUI()
