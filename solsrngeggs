local function sendWebhook(embed, pings)
	if type(SETTINGS.WEBHOOKS) ~= "table" or #SETTINGS.WEBHOOKS == 0 then return end
	local contentStr = ""
	if pings and #pings > 0 then contentStr = table.concat(pings, " ") end
	
	local data = {
		content = contentStr ~= "" and contentStr or nil,
		embeds = {embed},
		username = (SETTINGS.WH_USERNAME and SETTINGS.WH_USERNAME ~= "") and SETTINGS.WH_USERNAME or "NK - Egg Farming",
		avatar_url = (SETTINGS.WH_AVATAR and SETTINGS.WH_AVATAR ~= "") and SETTINGS.WH_AVATAR or "https://i.imgur.com/IqlIT6S.png"
	}
	
	local _req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
	if _req then
		local payload = HttpService:JSONEncode(data)
		task.spawn(function()
			local sentUrls = {}
			for _, wh in ipairs(SETTINGS.WEBHOOKS) do
				if wh.enabled and wh.url and wh.url ~= "" and not sentUrls[wh.url] then
					sentUrls[wh.url] = true
					pcall(function()
						_req({
							Url = wh.url,
							Method = "POST",
							Headers = {["Content-Type"] = "application/json"},
							Body = payload
						})
					end)
				end
			end
		end)
	end
end

