local function getBestJumpPlatform(targetPos)
	if not rootPart then return nil end
	local myPos = rootPart.Position
	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {character}
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local gapRay = workspace:Raycast(myPos + rootPart.CFrame.LookVector * 4 + Vector3.new(0, 2, 0), Vector3.new(0, -15, 0), rayParams)
	
	if not gapRay then
		local bestPart = nil
		local bestDist = (myPos - targetPos).Magnitude
		local parts = workspace:GetPartBoundsInRadius(myPos, 25)
		for _, obj in ipairs(parts) do
			if obj:IsA("BasePart") and obj.CanCollide and obj.Transparency < 1 and obj.Name ~= "PathBlocker" then
				local pDist = (obj.Position - myPos).Magnitude
				if pDist > 4 then
					local dy = obj.Position.Y - myPos.Y
					if dy > -10 and dy < 7.2 then
						local dTarget = (obj.Position - targetPos).Magnitude
						if dTarget < bestDist then
							bestDist = dTarget
							bestPart = obj
						end
					end
				end
			end
		end
		return bestPart
	end
	return nil
end

local function moveToEgg(egg)
	STATE.currentEggInstance = egg.instance
	if not rootPart or not egg.part or not egg.part.Parent then return false end
	if not pathAgent then guiLog("SimplePath Error", theme.Danger) return false end

	guiLog("Walking to: " .. egg.name, theme.Accent)
	
	local maxErrors = SETTINGS.PATH_RECOMPUTE_MAX * 3
	local errors, isCompleted = 0, false
	local conR, conB, conE, conW

	local function cleanup()
		if conR then conR:Disconnect() end if conB then conB:Disconnect() end
		if conE then conE:Disconnect() end if conW then conW:Disconnect() end
		pcall(function() pathAgent:Stop() end)
	end

	conR = pathAgent.Reached:Connect(function() isCompleted = true end)
	conB = pathAgent.Blocked:Connect(function() pcall(function() pathAgent:Run(egg.part.Position) end) end)
	conE = pathAgent.Error:Connect(function()
		errors = errors + 1
		local jumpPart = getBestJumpPlatform(egg.part.Position)
		if jumpPart and humanoid then
			humanoid.Jump = true
			humanoid:MoveTo(jumpPart.Position)
		elseif humanoid then 
			humanoid.Jump = true 
			humanoid:MoveTo(rootPart.Position + rootPart.CFrame.RightVector * math.random(-4, 4)) 
		end
		task.wait(0.5)
		pcall(function() pathAgent:Run(egg.part.Position) end)
	end)
	conW = pathAgent.WaypointReached:Connect(function()
		local dist = distanceTo(egg.part.Position)
		if dist <= SETTINGS.PROMPT_DISTANCE then isCompleted = true end
		STATE.currentTarget = string.format("%s (%.0fm)", egg.name, dist)
		updateGUI()
	end)

	pcall(function() pathAgent:Run(egg.part.Position) end)
	local lastPos = rootPart.Position
	local timeStuck = 0

	while STATE.running and not isCompleted do
		if not egg.part or not egg.part.Parent then break end
		if distanceTo(egg.part.Position) <= SETTINGS.PROMPT_DISTANCE then isCompleted = true break end
		if errors > maxErrors then break end

		local currentPos = rootPart.Position
		if (currentPos - lastPos).Magnitude < 0.2 then
			timeStuck = timeStuck + 0.1
			if timeStuck > 1.5 then
				local jumpPart = getBestJumpPlatform(egg.part.Position)
				if jumpPart and humanoid then
					humanoid.Jump = true
					humanoid:MoveTo(jumpPart.Position)
					task.wait(0.8)
				elseif humanoid then
					humanoid.Jump = true 
					humanoid:MoveTo(currentPos + rootPart.CFrame.RightVector * math.random(-5, 5) - rootPart.CFrame.LookVector * 2)
				end
				errors = errors + 1
				task.wait(0.5)
				pcall(function() pathAgent:Run(egg.part.Position) end)
				timeStuck = 0
			end
		else
			timeStuck = 0
		end
		lastPos = currentPos
		task.wait(0.1)
	end

	cleanup()
	if not STATE.running then return false end
	if isCompleted or (egg.part and egg.part.Parent and distanceTo(egg.part.Position) <= SETTINGS.PROMPT_DISTANCE) then
		collectEgg(egg)
		return true
	end
	return false
end

local mapFixed = false
local function fixMapGeometry()
	if mapFixed then return end
	mapFixed = true
	local leafygrass = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("leafygrass")
	if not leafygrass then return end
	local extDown = 25
	for _, obj in ipairs(leafygrass:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name ~= "PathBlocker" then
			local b = Instance.new("Part")
			b.Name = "PathBlocker"
			b.Size = Vector3.new(obj.Size.X, extDown, obj.Size.Z)
			b.CFrame = obj.CFrame * CFrame.new(0, -(obj.Size.Y / 2 + extDown / 2), 0)
			b.Anchored = true
			b.CanCollide = true
			b.Transparency = 1
			b.Parent = obj
		end
	end
end

