local function handleChatMessage(text)
	local plainText = string.gsub(text, "<[^>]+>", "")
	local tag, content = string.match(plainText, "^%[%s*(.-)%s*%]:%s*(.*)")
	if not tag then return end
	
	local psLink = (SETTINGS.PRIV_SERVER_LINK ~= "") and ("\n\n**Private Server:** [Click to Join]("..SETTINGS.PRIV_SERVER_LINK..")") or ""
	
	if BIOMES[tag] and SETTINGS.WH_BIOMES then
		local bInfo = BIOMES[tag]
		local pings = {}
		local isPinged = false
		local pingBiomes = string.split(string.lower(SETTINGS.PING_BIOMES_LIST or ""), ",")
		for _, pb in ipairs(pingBiomes) do
			local cleanPb = string.match(pb, "^%s*(.-)%s*$")
