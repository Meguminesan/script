local cachedEqBtn = nil
local function autoEquipAbyssal()
	local pg = player:WaitForChild("PlayerGui")
	local gs = game:GetService("GuiService")
	local function cleverClick(t)
		pcall(function()
			gs.SelectedObject = t task.wait()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game) task.wait()
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
			gs.SelectedObject = nil
		end)
		pcall(function()
			if getconnections then
				for _, ev in ipairs({t.MouseButton1Down, t.MouseButton1Click, t.Activated}) do
					for _, c in ipairs(getconnections(ev) or {}) do
						if type(c) == "table" and c.Function then c.Function() end
						if type(c) == "userdata" and type(c.Fire) == "function" then c:Fire() end
					end
				end
			end
		end)
	end
	local function toggleInv()
		local sb = pg:FindFirstChild("MainInterface") and pg.MainInterface:FindFirstChild("SideButtons")
		if sb then
			local btns = {}
			for _, b in ipairs(sb:GetChildren()) do if b:IsA("TextButton") then table.insert(btns, b) end end
			table.sort(btns, function(a, b) return a.AbsolutePosition.Y < b.AbsolutePosition.Y end)
			if btns[1] then cleverClick(btns[1]) task.wait(0.1) end
		end
	end

	toggleInv()
	local ac = false
	if cachedAbyssalBtn and cachedAbyssalBtn.Parent then
		cleverClick(cachedAbyssalBtn) ac = true
	else
		for _, obj in ipairs(pg:GetDescendants()) do
			if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and string.match(string.lower(obj.Text), "abyssal") then
				if obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0 then
					local btn = obj:FindFirstAncestorWhichIsA("GuiButton")
					if btn then cachedAbyssalBtn = btn cleverClick(btn) ac = true break end
				end
			end
		end
	end
	if not ac then toggleInv() return end
	task.wait(0.1)
	if cachedEqBtn and cachedEqBtn.Parent then
		cleverClick(cachedEqBtn) guiLog("Aura equipped!", theme.Success)
	else
		for _, obj in ipairs(pg:GetDescendants()) do
			if obj:IsA("ImageButton") and string.find(obj:GetFullName(), "MainInterface%.Frame%.Frame%.Frame%.Frame%.ImageButton%.ImageButton$") then
				cachedEqBtn = obj cleverClick(obj) guiLog("Aura equipped!", theme.Success) break
			end
		end
	end
	toggleInv()
end

local function mainLoop()
	fixMapGeometry()
	guiLog("Farming started!", theme.Success)
	while STATE.running do
		if SETTINGS.AUTO_EQUIP_ABYSSAL and rootPart and not rootPart:FindFirstChild("FishSpin") then
			autoEquipAbyssal() task.wait(0.5)
		end
		local eggs = findAllEggs()
		updateGUI()
		if #eggs == 0 then
			STATE.currentTarget = "Scanning..."
			STATE.status = "Searching"
			updateGUI()
			task.wait(SETTINGS.SEARCH_INTERVAL)
		else
			STATE.status = "Farming"
			for _, egg in ipairs(eggs) do
				if not STATE.running then break end
				if egg.part and egg.part.Parent then moveToEgg(egg) task.wait(0.3) end
			end
			task.wait(SETTINGS.SEARCH_INTERVAL)
		end
	end
	STATE.currentTarget = "—"
	STATE.status = "Stopped"
	updateGUI()
	guiLog("Farming stopped", theme.Danger)
end

