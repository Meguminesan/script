			if getconnections then
				for _, ev in ipairs({t.MouseButton1Down, t.MouseButton1Click, t.Activated}) do
					for _, c in ipairs(getconnections(ev) or {}) do
						if type(c) == "table" and c.Function then c.Function() end
						if type(c) == "userdata" and type(c.Fire) == "function" then c:Fire() end
					end
				end
			end
		end)
	end
	local function toggleInv()
		local sb = pg:FindFirstChild("MainInterface") and pg.MainInterface:FindFirstChild("SideButtons")
		if sb then
			local btns = {}
			for _, b in ipairs(sb:GetChildren()) do if b:IsA("TextButton") then table.insert(btns, b) end end
			table.sort(btns, function(a, b) return a.AbsolutePosition.Y < b.AbsolutePosition.Y end)
			if btns[1] then cleverClick(btns[1]) task.wait(0.1) end
		end
	end

