local function sendWebhook(embed, pings)
	if not SETTINGS.WEBHOOK_URL or SETTINGS.WEBHOOK_URL == "" then return end
	local contentStr = ""
	if pings and #pings > 0 then contentStr = table.concat(pings, " ") end
	
	local data = {
		content = contentStr ~= "" and contentStr or nil,
		embeds = {embed},
		username = "NK Farm Webhook",
		avatar_url = "https://i.imgur.com/71G0O4R.png"
	}
	
	local _req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
	if _req then
		task.spawn(function()
			pcall(function()
				_req({
					Url = SETTINGS.WEBHOOK_URL,
					Method = "POST",
					Headers = {["Content-Type"] = "application/json"},
					Body = HttpService:JSONEncode(data)
				})
			end)
		end)
	end
end

