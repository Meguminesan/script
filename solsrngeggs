local function handleChatMessage(text)
	if getgenv().NK_Farm_Unloaded or getgenv().NK_Farm_InstanceId ~= scriptId then return end
	local now = os.clock()
	for k, v in pairs(getgenv().NK_Farm_SharedChatCache) do
		if now - v > 10 then getgenv().NK_Farm_SharedChatCache[k] = nil end
	end

	local plainText = string.gsub(text, "<[^>]+>", "")
	
	local dName, uName, auraName, chanceStr = string.match(plainText, "^%s*(.-)%(@(.-)%) HAS FOUND (.-), CHANCE OF 1 IN (.-)!")
	if dName and uName and auraName and chanceStr and SETTINGS.WH_AURAS then
		if uName == player.Name then
			local msgHash = "AURA" .. uName .. auraName .. chanceStr
			if getgenv().NK_Farm_SharedChatCache[msgHash] then return end
			getgenv().NK_Farm_SharedChatCache[msgHash] = now
			
			local chanceNum = tonumber((string.gsub(chanceStr, ",", ""))) or 0
			local minSend = tonumber((string.gsub(tostring(SETTINGS.WH_AURA_MIN_CHANCE), ",", ""))) or 0
			local minPing = tonumber((string.gsub(tostring(SETTINGS.WH_AURA_PING_MIN_CHANCE), ",", ""))) or 0
			
			if chanceNum >= minSend then
				local pings = {}
				if chanceNum >= minPing then
					for i = 1, 4 do
						local uid = SETTINGS["PING_USER_"..i]
						if uid and uid ~= "" then table.insert(pings, "<@"..uid..">") end
					end
				end
				
				local activeVip = ""
				if type(SETTINGS.VIP_LINKS) == "table" then
					for _, v in ipairs(SETTINGS.VIP_LINKS) do
						if v.enabled and v.url ~= "" then activeVip = v.url break end
					end
				end
				
				local psLink = (activeVip ~= "") and ("\n\n**Private Server:** [Click to Join]("..activeVip..")") or ""
				local embed = {
					title = "🌟 Aura Found!",
					description = "**" .. dName .. "** (@" .. uName .. ") HAS FOUND **" .. auraName .. "**, CHANCE OF 1 IN **" .. chanceStr .. "**!" .. psLink,
					color = 0xAA00FF,
					timestamp = DateTime.now():ToIsoDate()
				}
				sendWebhook(embed, pings)
			end
		end
		return
	end
	
	local tag, content = string.match(plainText, "^%[%s*(.-)%s*%]:%s*(.*)")
	if not tag then return end
	
	local msgHash = tag .. content
	if getgenv().NK_Farm_SharedChatCache[msgHash] then return end
	getgenv().NK_Farm_SharedChatCache[msgHash] = now
	
	local activeVip = ""
	if type(SETTINGS.VIP_LINKS) == "table" then
		for _, v in ipairs(SETTINGS.VIP_LINKS) do
			if v.enabled and v.url ~= "" then
				activeVip = v.url break
			end
		end
