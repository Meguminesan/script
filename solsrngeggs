local function getEggInfo(name)
	if EGG_DATA[name] then return EGG_DATA[name] end
	local pNum = string.match(name, "^point_egg_(%d+)$")
	if pNum then
		local romans = {"I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"}
		return { name = "Point Egg " .. (romans[tonumber(pNum)] or pNum), priority = 3, rare = false }
	end
	local rNum = string.match(name, "^random_potion_egg_(%d+)$")
	if rNum then
		local romans = {"I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"}
		return { name = "Potion Egg " .. (romans[tonumber(rNum)] or rNum), priority = 2, rare = true }
	end
	return nil
end

